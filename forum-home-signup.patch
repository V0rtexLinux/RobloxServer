diff --git a/RobloxServer.Web/Content/Pages/Welcome.css b/RobloxServer.Web/Content/Pages/Welcome.css
new file mode 100644
index 0000000..6ab7e76
--- /dev/null
+++ b/RobloxServer.Web/Content/Pages/Welcome.css
@@ -0,0 +1,67 @@
+/* Home page of visitors (2012 look). Width of the site body: 970px. */
+#wl { width: 970px; margin: 0 auto; font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #000; }
+#wl a { text-decoration: none; }
+#wl a:hover { text-decoration: underline; }
+#wl-left { float: left; width: 650px; }
+#wl-right { float: right; width: 300px; }
+.wl-row { height: 244px; }
+
+/* Member Login */
+#wl-login { float: left; width: 258px; height: 242px; border: 1px solid #bbb; background: #f3f3f3; }
+#wl-login .wl-login-title { font-weight: bold; font-size: 12px; letter-spacing: 1px; color: #555; padding: 8px 10px 6px 10px; border-bottom: 1px solid #ddd; background: #e8e8e8; }
+#wl-login label { display: block; font-weight: bold; margin: 8px 10px 2px 10px; }
+#wl-login input[type=text], #wl-login input[type=password] { display: block; width: 230px; margin: 0 10px; padding: 3px; font-size: 13px; border: 1px solid #a8a8a8; box-sizing: content-box; }
+#wl-login a.wl-forgot, #wl-login a.wl-forgot:visited { display: block; margin: 4px 10px 0 10px; font-size: 11px; color: #0055aa; }
+#wl-login input.wl-signin { margin: 8px 10px 0 10px; padding: 4px 16px; font-weight: bold; font-size: 13px; color: #333; cursor: pointer; border: 1px solid #999; border-radius: 3px; background: #e6e6e6; }
+#wl-login input.wl-signin:hover { background: #d9d9d9; }
+#wl-login .wl-notmember { margin: 12px 10px 0 10px; padding-top: 10px; border-top: 1px solid #ddd; }
+#wl-login .wl-notmember span { display: inline-block; vertical-align: middle; margin-right: 8px; font-size: 13px; }
+#wl-login a.wl-signup, #wl-login a.wl-signup:visited { display: inline-block; vertical-align: middle; padding: 6px 16px; font-weight: bold; font-size: 14px; color: #fff; border: 1px solid #1d5aa8; border-radius: 3px; background: #2a7ad5; }
+#wl-login a.wl-signup:hover { background: #1f67b8; text-decoration: none; }
+
+/* Video box */
+#wl-video { float: left; margin-left: 12px; width: 362px; height: 199px; padding: 6px; background: #000; border: 1px solid #222; position: relative; }
+#wl-video img { display: block; }
+#wl-video .wl-play-overlay { position: absolute; left: 50%; top: 50%; width: 56px; height: 40px; margin: -20px 0 0 -28px; border-radius: 8px; background: rgba(20, 20, 20, 0.8); border: 1px solid #666; }
+#wl-video .wl-play-overlay:after { content: ""; position: absolute; left: 22px; top: 11px; border-left: 16px solid #fff; border-top: 9px solid transparent; border-bottom: 9px solid transparent; }
+#wl-video a:hover .wl-play-overlay { background: rgba(200, 30, 30, 0.9); }
+
+/* Banner */
+#wl-banner { height: 76px; margin-top: 8px; padding: 0 12px; line-height: 76px; overflow: hidden; border: 1px solid #333; background: linear-gradient(90deg, #5a1010 0%, #1b1b1b 35%, #111 100%); }
+#wl-banner .wl-banner-logo { display: inline-block; vertical-align: middle; line-height: 1; padding: 6px 10px; margin-right: 14px; color: #fff; font-weight: bold; font-size: 22px; letter-spacing: 1px; background: #c7191b; border-radius: 4px; text-shadow: 1px 1px 0 #600; }
+#wl-banner .wl-banner-text { display: inline-block; vertical-align: middle; color: #fff; font-weight: bold; font-size: 15px; }
+#wl-banner a.wl-banner-btn, #wl-banner a.wl-banner-btn:visited { float: right; margin-top: 20px; line-height: 1; padding: 11px 20px; font-weight: bold; font-size: 17px; color: #fff; border-radius: 3px; border: 1px solid #1d5aa8; background: #2a7ad5; }
+#wl-banner a.wl-banner-btn:hover { background: #1f67b8; text-decoration: none; }
+#wl-banner .wl-arrow { font-size: 14px; margin-right: 4px; }
+
+/* Featured Free Game */
+#wl-featured-title { margin: 14px 0 6px 0; font-size: 28px; font-weight: bold; font-family: Arial, Helvetica, sans-serif; color: #000; }
+#wl-featured { overflow: hidden; }
+#wl-featured.wl-empty { padding: 14px; border: 1px solid #ccc; background: #f6f6f6; font-size: 13px; }
+.wl-feat-info { float: left; width: 250px; }
+.wl-feat-name { font-weight: bold; font-size: 13px; margin-bottom: 8px; }
+.wl-feat-name a { color: #000; }
+.wl-feat-name span { font-weight: normal; font-size: 11px; color: #555; }
+.wl-feat-name span a { color: #0055aa; }
+#wl a.wl-play-this, #wl a.wl-play-this:visited { display: inline-block; padding: 8px 18px; margin-bottom: 10px; font-weight: bold; font-size: 15px; color: #fff; border: 1px solid #1d5aa8; border-radius: 3px; background: #2a7ad5; }
+#wl a.wl-play-this:hover { background: #1f67b8; text-decoration: none; }
+.wl-feat-info dl { margin: 4px 0 0 0; font-size: 11px; color: #666; }
+.wl-feat-info dt { float: left; clear: left; width: 62px; }
+.wl-feat-info dd { margin: 0 0 3px 62px; }
+.wl-feat-thumb { float: right; }
+.wl-feat-thumb img { display: block; border: 1px solid #aaa; }
+
+/* Right column */
+#wl-bigplay, #wl-bigplay:visited { display: block; width: 260px; height: 260px; margin: 0 auto 14px auto; border-radius: 50%; text-align: center; color: #fff; background: radial-gradient(circle at 50% 30%, #4ed03a 0%, #2da31b 60%, #1f7d11 100%); border: 3px solid #fff; box-shadow: 0 0 0 2px #2a8a1a, 0 3px 8px rgba(0, 0, 0, 0.35); }
+#wl-bigplay span { display: block; padding-top: 62px; font-size: 56px; font-weight: bold; line-height: 62px; text-shadow: 2px 2px 0 #166209; }
+#wl-bigplay:hover { text-decoration: none; filter: brightness(1.08); }
+.wl-promo { height: 120px; margin-bottom: 12px; padding: 12px 14px; box-sizing: border-box; border: 1px solid #1d3d6e; color: #fff; }
+.wl-promo-download { background: linear-gradient(135deg, #2a62b4, #0f2f63); }
+.wl-promo-forum { background: linear-gradient(135deg, #3a8a2e, #1b4a14); }
+.wl-promo b { font-size: 16px; }
+.wl-promo p { margin: 6px 0 10px 0; font-size: 12px; line-height: 16px; }
+#wl .wl-promo a, #wl .wl-promo a:visited { display: inline-block; padding: 5px 12px; font-weight: bold; color: #000; background: #fff; border-radius: 3px; }
+#wl-news { margin-top: 6px; }
+.wl-news-title { font-weight: bold; font-size: 12px; color: #555; padding-bottom: 4px; border-bottom: 1px solid #ddd; margin-bottom: 4px; }
+.wl-news-item { padding: 3px 0; font-size: 12px; }
+.wl-news-item a { color: #0055aa; }
